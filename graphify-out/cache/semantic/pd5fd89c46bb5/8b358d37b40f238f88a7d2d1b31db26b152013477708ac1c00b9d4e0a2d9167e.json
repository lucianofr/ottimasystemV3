{"nodes": [{"id": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime", "label": "ADR-006 \u2014 Separa\u00e7\u00e3o de processos: opc-worker \u00d7 flow-runtime \u00d7 recorder", "file_type": "document", "source_file": "docs/archive/adr/ADR-006-separacao-opc-worker-flow-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime_decisao", "label": "Decision: distinct asyncio processes (opc-worker sole OPC-UA talker, flow-runtime executes flows, recorder writes hypertable) connected only by the bus", "file_type": "rationale", "source_file": "docs/archive/adr/ADR-006-separacao-opc-worker-flow-runtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The MPC solver is CPU-bound while OPC acquisition is jitter-sensitive; sharing a process lets solver CPU spikes delay sampling/writes. Isolation gives jitter containment, independent restart, and per-process scaling; cost: multi-process observability (health/heartbeat per service)."}], "edges": [{"source": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime_decisao", "target": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-006-separacao-opc-worker-flow-runtime.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime_decisao", "target": "docs_archive_adr_adr_002_barramento_redis_pubsub_decisao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-006-separacao-opc-worker-flow-runtime.md", "source_location": null, "weight": 1.0}], "hyperedges": []}