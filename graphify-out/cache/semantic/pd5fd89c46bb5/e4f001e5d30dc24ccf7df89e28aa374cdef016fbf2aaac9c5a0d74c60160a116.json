{"nodes": [{"id": "docs_archive_adr_adr_004_loops_vivos_asyncio_sem_celery", "label": "ADR-004 \u2014 Loops vivos em asyncio; sem Celery", "file_type": "document", "source_file": "docs/archive/adr/ADR-004-loops-vivos-asyncio-sem-celery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_adr_adr_004_loops_vivos_asyncio_sem_celery_decisao", "label": "Decision: MPC/scripts/OPC sessions as asyncio tasks in dedicated workers; Celery out; blocking solve via run_in_executor", "file_type": "rationale", "source_file": "docs/archive/adr/ADR-004-loops-vivos-asyncio-sem-celery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MPC and OPC-UA are continuous stateful loops, not discrete jobs, and the scope has no discrete jobs. State persists between cycles with no queueing overhead; if solvers contend for CPU, partition flows across processes (one event loop per core) \u2014 never migrate to Celery."}], "edges": [{"source": "docs_archive_adr_adr_004_loops_vivos_asyncio_sem_celery_decisao", "target": "docs_archive_adr_adr_004_loops_vivos_asyncio_sem_celery", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-004-loops-vivos-asyncio-sem-celery.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_004_loops_vivos_asyncio_sem_celery_decisao", "target": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime_decisao", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/archive/adr/ADR-004-loops-vivos-asyncio-sem-celery.md", "source_location": null, "weight": 1.0}], "hyperedges": []}