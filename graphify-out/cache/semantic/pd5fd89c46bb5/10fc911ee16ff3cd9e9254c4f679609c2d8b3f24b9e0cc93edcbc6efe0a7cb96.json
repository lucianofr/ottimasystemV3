{"nodes": [{"id": "docs_archive_adr_adr_020_log_eventos_sem_ack", "label": "ADR-020 \u2014 Log de eventos persistido, banner de alarmes, sem ACK", "file_type": "document", "source_file": "docs/archive/adr/ADR-020-log-eventos-sem-ack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_adr_adr_020_log_eventos_sem_ack_decisao", "label": "Decision: persisted event log (hypertable, 1-month retention; ts/severity/origin/message/payload), active-alarm banner derived from current state, no ACK; realtime fanout via events channel", "file_type": "rationale", "source_file": "docs/archive/adr/ADR-020-log-eventos-sem-ack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational events (solver overrun, script timeout/exception, watchdog failure, mode change, manual writes, deploy, project activation) need a trail; the same log yields operation auditing for free. Without ACK there is no acknowledged state to persist \u2014 the banner is purely derived (stateless). 1-month retention explicitly accepted for audit too."}], "edges": [{"source": "docs_archive_adr_adr_020_log_eventos_sem_ack_decisao", "target": "docs_archive_adr_adr_020_log_eventos_sem_ack", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-020-log-eventos-sem-ack.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_020_log_eventos_sem_ack_decisao", "target": "docs_archive_adr_adr_002_barramento_redis_pubsub_decisao", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/archive/adr/ADR-020-log-eventos-sem-ack.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_020_log_eventos_sem_ack_decisao", "target": "docs_archive_adr_adr_003_timescaledb_unico_retencao_1mes_decisao", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/archive/adr/ADR-020-log-eventos-sem-ack.md", "source_location": null, "weight": 1.0}], "hyperedges": []}