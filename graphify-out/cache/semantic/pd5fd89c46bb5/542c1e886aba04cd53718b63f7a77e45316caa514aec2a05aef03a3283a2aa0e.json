{"nodes": [{"id": "docs_archive_adr_adr_009_watchdog_bit_alternante", "label": "ADR-009 \u2014 Watchdog de comunica\u00e7\u00e3o por bit alternante (NOT cruzado)", "file_type": "document", "source_file": "docs/archive/adr/ADR-009-watchdog-bit-alternante.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_adr_adr_009_watchdog_bit_alternante_decisao", "label": "Decision: per-connection watchdog with two OPC bits (read+write), crossed NOT, frozen >10s declares comm failure; failure stops writes and flows", "file_type": "rationale", "source_file": "docs/archive/adr/ADR-009-watchdog-bit-alternante.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A system writing to the plant needs active symmetric loss detection independent of OPC session status; the mechanism is trivial in any PLC (one rung). Toggle period must be well under 10s (1-2s cycle, independent of flow Ts); on failure the PLC's own watchdog resumes conventional control."}], "edges": [{"source": "docs_archive_adr_adr_009_watchdog_bit_alternante_decisao", "target": "docs_archive_adr_adr_009_watchdog_bit_alternante", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-009-watchdog-bit-alternante.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_009_watchdog_bit_alternante_decisao", "target": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime_decisao", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/archive/adr/ADR-009-watchdog-bit-alternante.md", "source_location": null, "weight": 1.0}], "hyperedges": []}