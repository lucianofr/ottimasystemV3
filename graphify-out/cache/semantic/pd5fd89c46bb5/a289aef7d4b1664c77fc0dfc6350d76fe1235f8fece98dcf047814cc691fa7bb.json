{"nodes": [{"id": "docs_archive_adr_adr_015_papeis_admin_operador", "label": "ADR-015 \u2014 Pap\u00e9is: admin e OPERADOR (rename de visualizador)", "file_type": "document", "source_file": "docs/archive/adr/ADR-015-papeis-admin-operador.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_adr_adr_015_papeis_admin_operador_decisao", "label": "Decision: two roles \u2014 admin (engineering + all operation) and operador (modes, SP, MV in MAN; sees everything; no engineering edits)", "file_type": "rationale", "source_file": "docs/archive/adr/ADR-015-papeis-admin-operador.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A read-only viewer role would make engineer and panel operator the same person; the split mirrors a real control room. Supersedes the role definition of ADR-001. RBAC stays trivial (role column + require_admin/require_operator); every operation write is auditable."}], "edges": [{"source": "docs_archive_adr_adr_015_papeis_admin_operador_decisao", "target": "docs_archive_adr_adr_015_papeis_admin_operador", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-015-papeis-admin-operador.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_015_papeis_admin_operador_decisao", "target": "docs_archive_adr_adr_001_fastapi_all_in_decisao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-015-papeis-admin-operador.md", "source_location": null, "weight": 1.0}], "hyperedges": []}