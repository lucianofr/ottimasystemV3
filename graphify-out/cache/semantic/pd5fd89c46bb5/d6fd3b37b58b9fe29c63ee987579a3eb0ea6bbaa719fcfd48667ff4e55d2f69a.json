{"nodes": [{"id": "docs_archive_claude", "label": "CLAUDE.md (archived) \u2014 OttimaSystem agent operating rules", "file_type": "document", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_claude_adrs_normativos", "label": "ADRs 001-023 are normative; ADR wins any conflict", "file_type": "rationale", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decisions recorded in ADRs cannot be relitigated or circumvented in code; on conflict between code, plan, PRD and ADR, the ADR wins. Gaps or contradictions must stop work and be escalated as ADR/PRD update proposals, never silently resolved in code. Product design is closed; brainstorming is only about implementation."}, {"id": "docs_archive_claude_invariante_event_loop", "label": "Invariant: never block the asyncio event loop", "file_type": "rationale", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mpc.make_step() (IPOPT) and script exec() are CPU-bound and blocking, so they always run via run_in_executor; blocking the loop would destroy scan determinism (ADR-004)."}, {"id": "docs_archive_claude_opc_worker_unico", "label": "Invariant: opc-worker is the only process that speaks OPC-UA", "file_type": "rationale", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All other services consume the Redis bus; single OPC talker isolates jitter and failure domains (ADR-006)."}, {"id": "docs_archive_claude_fire_and_forget_estado_publicado", "label": "Invariant: pub/sub is fire-and-forget; UI reflects published state, never command echo", "file_type": "rationale", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis pub/sub has no delivery guarantee, so commands go over flow.commands and the UI renders only state published back by the runtime (ADR-002)."}, {"id": "docs_archive_claude_stack", "label": "Reference stack: React+Vite+shadcn+React Flow+uPlot, FastAPI+SQLAlchemy 2.0 async, Postgres/TimescaleDB, Redis pub/sub, uv, Docker Compose", "file_type": "concept", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_claude_monorepo_layout", "label": "Monorepo layout: docs/, frontend/, packages/ottima-core, services/{api,opc-worker,flow-runtime,recorder}, deploy/, tests/ as uv workspace", "file_type": "concept", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_claude_tdd_malha_fechada", "label": "Strict TDD on pure logic; MPC<->TFS closed loop is the acceptance suite (RNF-09)", "file_type": "rationale", "source_file": "docs/archive/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure logic (scan engine, SOPDT/IOPDT discretization, do-mpc assembly, Restricao>CV precedence, bumpless, TFS) gets RED-GREEN-REFACTOR; opc-worker is tested against asyncua's in-process test server; closed-loop MPC<->TFS without hardware proves bumpless takeover/handback, constraint precedence and overrun handling. No TDD theater on infra."}], "edges": [{"source": "docs_archive_claude_adrs_normativos", "target": "docs_archive_claude", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_invariante_event_loop", "target": "docs_archive_claude", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_opc_worker_unico", "target": "docs_archive_claude", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_fire_and_forget_estado_publicado", "target": "docs_archive_claude", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_tdd_malha_fechada", "target": "docs_archive_claude", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_adrs_normativos", "target": "docs_archive_prd", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_adrs_normativos", "target": "docs_archive_glossary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_invariante_event_loop", "target": "docs_archive_adr_adr_004_loops_vivos_asyncio_sem_celery_decisao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_claude_opc_worker_unico", "target": "docs_archive_adr_adr_006_separacao_opc_worker_flow_runtime_decisao", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/CLAUDE.md", "source_location": null, "weight": 1.0