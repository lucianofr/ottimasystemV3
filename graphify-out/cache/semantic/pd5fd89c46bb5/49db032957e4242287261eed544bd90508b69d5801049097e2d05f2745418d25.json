{"nodes": [{"id": "docs_archive_adr_adr_007_scan_cycle_ts_por_flow", "label": "ADR-007 \u2014 Execu\u00e7\u00e3o por scan cycle com Ts individual por flow", "file_type": "document", "source_file": "docs/archive/adr/ADR-007-scan-cycle-ts-por-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_archive_adr_adr_007_scan_cycle_ts_por_flow_decisao", "label": "Decision: cyclic scan semantics; per-flow Ts from fixed list {0.5,1,2,5,10,30,60}s; blocks read latest bus snapshot", "file_type": "rationale", "source_file": "docs/archive/adr/ADR-007-scan-cycle-ts-por-flow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over event-driven reactivity for determinism and PLC/FBD familiarity; fixed Ts list removes arbitrary-value validation and simplifies the scheduler. Consequence: Ts=0.5s imposes a tight MPC solve budget, requiring an explicit solver overrun policy."}], "edges": [{"source": "docs_archive_adr_adr_007_scan_cycle_ts_por_flow_decisao", "target": "docs_archive_adr_adr_007_scan_cycle_ts_por_flow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/archive/adr/ADR-007-scan-cycle-ts-por-flow.md", "source_location": null, "weight": 1.0}, {"source": "docs_archive_adr_adr_007_scan_cycle_ts_por_flow_decisao", "target": "docs_archive_adr_adr_014_orcamento_solver_multiplicador_decisao", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/archive/adr/ADR-007-scan-cycle-ts-por-flow.md", "source_location": null, "weight": 1.0}], "hyperedges": []}