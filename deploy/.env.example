# ===== OttimaSystem — configuração de instalação (copie para deploy/.env) =====

# Porta HTTP única exposta (frontend/nginx)
OTTIMA_HTTP_PORT=80

# Banco (container timescaledb). A api/recorder montam a URL a partir destas vars.
POSTGRES_DB=ottima
POSTGRES_USER=ottima
POSTGRES_PASSWORD=troque-esta-senha

# URL usada FORA do compose (dev local: alembic/uv). Dentro do compose é derivada acima.
OTTIMA_DATABASE_URL=postgresql+asyncpg://ottima:troque-esta-senha@localhost:5432/ottima

# Barramento (ADR-002)
OTTIMA_REDIS_URL=redis://localhost:6379/0

# Segredo do JWT (RNF-04). Gerar: openssl rand -hex 32
OTTIMA_SECRET_KEY=

# Chave Fernet dos segredos de conexão OPC (spec F1 §5.4).
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OTTIMA_FERNET_KEY=

# Sessão (spec F1 §5.1): TTL do access token em horas
OTTIMA_TOKEN_TTL_HOURS=12

# Seed do primeiro admin (spec F1 §5.3) — usado só com a tabela users vazia
OTTIMA_ADMIN_USERNAME=admin
OTTIMA_ADMIN_PASSWORD=troque-esta-senha
OTTIMA_ADMIN_NAME=Administrador

OTTIMA_LOG_LEVEL=INFO

# Tamanho do pool de processos do ScriptPool das tags calculadas (docs/plans/tags-calculadas.md)
OTTIMA_CALC_POOL_SIZE=4

# Em quantos PROCESSOS o flow-runtime divide os flows (ADR-004, "um event loop por núcleo").
# 1 = um processo só, o comportamento de sempre. Acima de 1, o processo do compose vira pai:
# não executa flow, dá spawn em N filhos (posse por `flow_id % N`) e agrega o /health na mesma
# porta 8002. Vale subir quando um bloco de custo inline (Fuzzy grande, por exemplo) faz um
# flow roubar a fronteira de varredura dos outros; o teto útil é o número de núcleos do host.
# Cada partição sobe o próprio pool de scripts (SCRIPT_POOL_SIZE // N, piso 1) e o próprio
# espelho de valores, então N alto em host pequeno troca jitter por memória. Atenção ao efeito
# no bloco Script: com N=4 cada partição fica com UM worker, e os blocos Script dos flows
# daquela partição passam a esperar fila entre si (o estouro do orçamento vira alarme de
# script_timeout e mantém a última saída boa, RF-514 — não derruba o flow).
OTTIMA_FLOW_PARTITIONS=1

# flow-runtime roda código do bloco Script, que pode vir de um projeto importado de
# outra instalação (RNF-04); por isso não recebe .env inteiro via env_file, só
# OTTIMA_DATABASE_URL/OTTIMA_REDIS_URL/OTTIMA_LOG_LEVEL explícitos no compose — sem
# OTTIMA_SECRET_KEY nem OTTIMA_FERNET_KEY no ambiente do processo.
