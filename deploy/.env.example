# ===== OttimaSystem — configuração de instalação (copie para deploy/.env) =====

# Porta HTTP única exposta (frontend/nginx)
OTTIMA_HTTP_PORT=80

# Banco (container timescaledb). A api/recorder montam a URL a partir destas vars.
POSTGRES_DB=ottima
POSTGRES_USER=ottima
POSTGRES_PASSWORD=troque-esta-senha

# URL usada FORA do compose (dev local: alembic/uv). Dentro do compose é derivada acima.
OTTIMA_DATABASE_URL=postgresql+asyncpg://ottima:troque-esta-senha@localhost:5432/ottima

# Barramento (ADR-002)
OTTIMA_REDIS_URL=redis://localhost:6379/0

# Segredo do JWT (RNF-04). Gerar: openssl rand -hex 32
OTTIMA_SECRET_KEY=

# Chave Fernet dos segredos de conexão OPC (spec F1 §5.4).
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OTTIMA_FERNET_KEY=

# Sessão (spec F1 §5.1): TTL do access token em horas
OTTIMA_TOKEN_TTL_HOURS=12

# Seed do primeiro admin (spec F1 §5.3) — usado só com a tabela users vazia
OTTIMA_ADMIN_USERNAME=admin
OTTIMA_ADMIN_PASSWORD=troque-esta-senha
OTTIMA_ADMIN_NAME=Administrador

OTTIMA_LOG_LEVEL=INFO
