FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
ARG PACKAGE
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services
RUN uv sync --frozen --no-dev --package ${PACKAGE}

FROM python:3.12-slim-bookworm
WORKDIR /app
RUN useradd --create-home ottima && mkdir -p /certs
COPY --from=builder /app /app
COPY deploy/entrypoint-api.sh /app/deploy/entrypoint-api.sh
RUN chmod +x /app/deploy/entrypoint-api.sh && chown -R ottima:ottima /app /certs
ENV PATH="/app/.venv/bin:$PATH"
USER ottima
