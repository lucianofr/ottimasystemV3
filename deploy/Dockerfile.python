FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
ARG PACKAGE
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services
RUN uv sync --frozen --no-dev --package ${PACKAGE}

FROM python:3.12-slim-bookworm
WORKDIR /app
# O dono vem no próprio COPY: um `chown -R` depois dele duplicaria a camada inteira de /app
# (o ml-worker, com torch, passava de 2,7 GB).
RUN useradd --create-home ottima && mkdir -p /certs /certs-received \
 && chown ottima:ottima /app /certs /certs-received
COPY --from=builder --chown=ottima:ottima /app /app
COPY --chown=ottima:ottima deploy/entrypoint-api.sh /app/deploy/entrypoint-api.sh
RUN chmod +x /app/deploy/entrypoint-api.sh
ENV PATH="/app/.venv/bin:$PATH"
USER ottima
