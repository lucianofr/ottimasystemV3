RuleBlock: regras
  enabled: true
  conjunction: AlgebraicProduct
  disjunction: Maximum
  implication: AlgebraicProduct
  activation: General
  rule: if e1 is NG then du1 is NG
  rule: if e1 is NP then du1 is NP
  rule: if e1 is ZE and de1 is N then du1 is NP
  rule: if e1 is ZE and de1 is ZE then du1 is ZE
  rule: if e1 is ZE and de1 is P then du1 is PP
  rule: if e1 is PP then du1 is PP
  rule: if e1 is PG then du1 is PG
  rule: if e2 is PG and de2 is P then du1 is NP
  rule: if e2 is NG and de2 is N then du1 is PP
  rule: if e2 is NG then du2 is NG
  rule: if e2 is NP then du2 is NP
  rule: if e2 is ZE and de2 is N then du2 is NP
  rule: if e2 is ZE and de2 is ZE then du2 is ZE
  rule: if e2 is ZE and de2 is P then du2 is PP
  rule: if e2 is PP then du2 is PP
  rule: if e2 is PG then du2 is PG
  rule: if e1 is PG and de1 is P then du2 is NP
  rule: if e1 is NG and de1 is N then du2 is PP
