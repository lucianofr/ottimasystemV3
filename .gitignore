.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
uv.lock.orig
deploy/.env
# O diretorio precisa existir no checkout: e bind mount do opcsim (docker-compose.e2e.yml),
# e o Docker cria como root o que falta, quebrando o container que roda como UID 1000.
deploy/e2e-certs/*
!deploy/e2e-certs/.gitkeep
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/openapi.json
# scratch de ferramentas e config local (não é conhecimento de projeto)
.superpowers/
.claude/
.codex/
.cursor/
.impeccable/
.serena/
.tokensave/

# graphify: trava transitoria de rebuild (PID), nunca versionada
graphify-out/.rebuild.lock
# Added by code-review-graph
.code-review-graph/

